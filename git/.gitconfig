[user]
  name = Meisam
  email = your@email.com   # update this

[core]
  editor = nvim
  pager = delta
  excludesfile = ~/.gitignore_global

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[rebase]
  autoStash = true

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  syntax-theme = base16

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[alias]
  st = status
  co = checkout
  br = branch
  lg = log --oneline --graph --decorate --all
  last = log -1 HEAD
  undo = reset HEAD~1 --mixed
  alias = config --get-regexp alias
  # push current branch
  pushup = push -u origin HEAD

[color]
  ui = auto
